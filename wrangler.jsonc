{
  "name": "bizzytonelabs-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Keep variables and secrets set in the Cloudflare dashboard (STATS_TOKEN) when deploying from GitHub.
  "keep_vars": true,
  // Lets Cloudflare build a preview for each pull request (`npx wrangler preview`).
  "previews": {},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; every other request is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  // Daily cleanup of usage events older than 24 months (03:17 UTC).
  "triggers": { "crons": ["17 3 * * *"] },
  // Request logs would include IP addresses, so they stay off.
  "observability": { "enabled": false },
  "d1_databases": [
    { "binding": "DB", "database_name": "the-sports-analytics", "database_id": "9821e6c6-1a17-45b9-8634-1bc76fc41b02" }
  ]
}
